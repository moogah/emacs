#!/usr/bin/env bash
# emacs-agent - the single entry point through which an agent drives Emacs
#
# Every call names its target: `live' (the user's Emacs, serving the default
# `server' socket) or an isolated target by name.  Every emacsclient run goes
# through `emacs_agent_client', which passes `-s' with the absolute socket
# path, so no call reaches an Emacs it did not name.  Tool names, JSON and
# forms reach Emacs as Lisp string literals, never spliced into a form.
#
# Usage: see `emacs_agent_usage' below, or run `emacs-agent --help'.
#
# Exit status: 0 on success; 1 on a failure envelope, an eval error or a
# target that refuses connections while a process holds its socket (busy);
# 2 on a usage error, a target that is not running, or a target start that
# fails or is refused.
#
# Environment:
#   EMACS_AGENT_EMACSCLIENT   emacsclient to run (default: beside the Emacs)
#   EMACS_AGENT_EMACS         Emacs to run (default: Emacs.app, else PATH)

set -uo pipefail
# Bash 5.2 reads `&' in a ${var//pattern/replacement} replacement as the match.
shopt -u patsub_replacement 2>/dev/null || true

# emacsclient falls back on these when a connection fails; the wrapper names
# its socket explicitly and must never start an Emacs or try another socket.
unset ALTERNATE_EDITOR EMACS_SOCKET_NAME EMACS_SERVER_FILE

EMACS_AGENT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EMACS_AGENT_TARGET_SUPPORT="$EMACS_AGENT_ROOT/config/emacs-agent/target-support.el"

emacs_agent_usage() {
    cat <<'EOF'
Usage:
  emacs-agent live tools                          list the live session's tools (JSON)
  emacs-agent live call       TOOL 'JSON'         call a read-preset tool
  emacs-agent live call-write TOOL 'JSON'         call a read- or write-preset tool
  emacs-agent live eval       'FORM'              evaluate raw Elisp (JSON envelope)

  emacs-agent target start NAME [--worktree PATH] [--bare] [--data PROFILE]
  emacs-agent target list
  emacs-agent target stop NAME
  emacs-agent target NAME tools
  emacs-agent target NAME call       TOOL 'JSON'
  emacs-agent target NAME call-write TOOL 'JSON'
  emacs-agent target NAME eval       'FORM'       prints the value's printed form
  emacs-agent target NAME state                   frame state (JSON)

  emacs-agent --help

Targets:
  live is the user's Emacs, serving the default `server' socket.  An isolated
  target is addressed by NAME, its socket name; server, start, list and stop
  are not target names.

  target start runs the worktree's bin/emacs-isolated.sh --daemon=NAME
  (--worktree defaults to the checkout holding this script) with the data
  profile in EMACS_AGENT_DATA, or with --bare runs emacs -Q --daemon=NAME,
  which loads no configuration and takes neither --worktree nor --data.  It
  returns once the target's server is ready.  target list prints the running
  targets' names; target stop sends (kill-emacs) and returns once the
  target's socket is gone.  A target, or the live session, whose socket is
  missing, or refuses connections while no process holds it, is not running
  (exit 2); list and stop remove such a target's socket, and start replaces
  it.  One that refuses connections while a process holds its socket is
  busy, its accept queue full (exit 1): list prints it as `NAME (busy)',
  stop fails, start refuses its name (exit 2), and its socket stays.  Busy
  is told by lsof; without a working lsof a refusing socket counts as not
  running, so start replaces it.  start refuses the name of a target that
  answers too: Emacs reports it already running (exit 2).

  --data PROFILE   the data profile of a worktree target:
                     live            the user's notes
                     scratch:<dir>   a scratch vault at the absolute <dir>
                     none            no notes (the default when --data is omitted)

Exit status:
  0 success; 1 a failure envelope, an eval error or a busy target; 2 a
  usage error, a target that is not running, or a target start that fails
  or is refused.

Environment:
  EMACS_AGENT_EMACSCLIENT, EMACS_AGENT_EMACS name the binaries; otherwise the
  emacsclient beside the Emacs is used.
EOF
}

emacs_agent_usage_error() {
    printf 'emacs-agent: %s\n' "$1" >&2
    printf "Run 'emacs-agent --help' for usage.\n" >&2
    exit 2
}

emacs_agent_fail() {
    printf 'emacs-agent: %s\n' "$1" >&2
    exit "${2:-1}"
}

# The one derivation of the socket directory, as Emacs's `server-socket-dir'
# expands it: $XDG_RUNTIME_DIR/emacs, else emacs<uid> under ${TMPDIR:-/tmp}
# with TMPDIR's trailing slash dropped.  Symlinks are not resolved.
emacs_agent_socket_dir() {
    if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
        printf '%s/emacs' "${XDG_RUNTIME_DIR%/}"
    else
        local tmp="${TMPDIR:-/tmp}"
        printf '%s/emacs%s' "${tmp%/}" "$(id -u)"
    fi
}

emacs_agent_socket() {
    printf '%s/%s' "$(emacs_agent_socket_dir)" "$1"
}

emacs_agent_emacs() {
    if [[ -n "${EMACS_AGENT_EMACS:-}" ]]; then
        printf '%s' "$EMACS_AGENT_EMACS"
    elif [[ -x /Applications/Emacs.app/Contents/MacOS/Emacs ]]; then
        printf '%s' /Applications/Emacs.app/Contents/MacOS/Emacs
    else
        command -v emacs
    fi
}

emacs_agent_emacsclient() {
    if [[ -n "${EMACS_AGENT_EMACSCLIENT:-}" ]]; then
        printf '%s' "$EMACS_AGENT_EMACSCLIENT"
        return 0
    fi
    local emacs dir candidate
    emacs="$(emacs_agent_emacs)"
    if [[ -n "$emacs" ]]; then
        dir="$(dirname "$emacs")"
        for candidate in "$dir/bin/emacsclient" "$dir/emacsclient"; do
            if [[ -x "$candidate" ]]; then
                printf '%s' "$candidate"
                return 0
            fi
        done
    fi
    command -v emacsclient
}

# Print the pids of the processes that hold SOCKET open, as lsof finds
# them.  Return 0 when some process holds it, 1 when lsof finds none, and 2
# when that cannot be told (no lsof, or lsof reports an error).
emacs_agent_socket_holders() {
    local socket="$1" lsof pids status
    lsof="$(command -v lsof)" || lsof=/usr/sbin/lsof
    [[ -x "$lsof" ]] || return 2
    pids="$("$lsof" -t -- "$socket" 2>/dev/null)"
    status=$?
    if [[ -n "$pids" ]]; then
        printf '%s' "${pids//$'\n'/ }"
        return 0
    fi
    # lsof exits 1 both when nothing holds the file and when the file is
    # gone (it then complains on stderr); only the first answers the
    # question.
    [[ $status -eq 1 && -S "$socket" ]] && return 1
    return 2
}

# Report why the socket NAME (`server' for live) refused emacsclient's
# connection.  On macOS a listening socket also refuses one when its accept
# queue is full, so a refusal alone does not mean the Emacs is gone: while
# a process holds the socket the Emacs is busy, and the refusal is a
# transient failure (return 3); otherwise it is not running (return 2).
emacs_agent_refused() {
    local name="$1" socket pids
    socket="$(emacs_agent_socket "$name")"
    pids="$(emacs_agent_socket_holders "$socket")"
    case $? in
        0)
            emacs_agent_not_accepting "$name" "process $pids holds $socket"
            return 3 ;;
        1)
            emacs_agent_not_running "$name" "no process holds $socket" ;;
        *)
            emacs_agent_not_running "$name" "nothing accepted a connection on $socket" ;;
    esac
    return 2
}

# Run emacsclient against the socket NAME (`server' for live), always with -s
# and the socket's absolute path; the remaining arguments follow.  stdout
# passes through.  When emacsclient cannot connect (it says "error accessing
# socket") return what `emacs_agent_refused' finds: 2 for an Emacs that is
# not running, 3 for one that is busy.  Otherwise pass its stderr on and
# return its status.  No other socket is tried.
emacs_agent_client() {
    local name="$1"
    shift
    local client socket err status
    client="$(emacs_agent_emacsclient)" ||
        emacs_agent_fail "no emacsclient found; set EMACS_AGENT_EMACSCLIENT"
    socket="$(emacs_agent_socket "$name")"
    { err="$("$client" -s "$socket" "$@" 2>&1 1>&3 3>&-)"; } 3>&1
    status=$?
    if [[ $status -ne 0 && "$err" == *"error accessing socket"* ]]; then
        emacs_agent_refused "$name"
        return
    fi
    [[ -z "$err" ]] || printf '%s\n' "$err" >&2
    return "$status"
}

# Print STRING as an Elisp string literal: backslash and double quote escaped,
# everything else (newlines, non-ASCII) literal.
emacs_agent_lisp_string() {
    local LC_ALL=C
    local s="$1" bs='\' dq='"'
    s="${s//"$bs"/$bs$bs}"
    s="${s//"$dq"/$bs$dq}"
    printf '"%s"' "$s"
}

# Undo emacsclient's printing of a string value (`prin1', with newlines and
# form feeds escaped as \n and \f) and print the string itself followed by a
# newline.  Return 1, printing nothing, when the reply is not a printed string.
emacs_agent_decode_reply() {
    # Bytes, not characters: the escapes are ASCII, and the UTF-8 locale
    # makes pattern substitution over a long reply take seconds.
    local LC_ALL=C
    local s="$1" bs='\' dq='"' mark=''
    s="${s%$'\n'}"
    if [[ ${#s} -lt 2 || "${s:0:1}" != "$dq" || "${s: -1}" != "$dq" ]]; then
        return 1
    fi
    s="${s:1:${#s}-2}"
    # A printed string carries its newlines as \n.  A raw one is emacsclient
    # reporting a reply it could not read: on macOS it splits a long reply
    # holding non-ASCII characters and prints "*ERROR*: Unknown message".
    [[ "$s" != *$'\n'* ]] || return 1
    # An escaped backslash becomes a control character the text lacks, so
    # every backslash left starts one of the other escapes.
    for mark in $'\001' $'\002' $'\003' $'\004' $'\005' $'\006' ''; do
        [[ "$s" != *"$mark"* ]] && break
    done
    [[ -n "$mark" ]] || return 1
    s="${s//"$bs$bs"/$mark}"
    s="${s//"$bs$dq"/$dq}"
    s="${s//"${bs}n"/$'\n'}"
    s="${s//"${bs}f"/$'\f'}"
    # What is left are the octal escapes of raw bytes (a unibyte string's
    # UTF-8, \303\251 for é), always three digits: printed as the bytes.
    if [[ "$s" == *"$bs"* ]]; then
        s="$(printf '%b' "${s//"$bs"/${bs}0}"; printf x)"
        s="${s%x}"
    fi
    s="${s//"$mark"/$bs}"
    printf '%s\n' "$s"
}

# Refuse NAME as a target name: missing, reserved, or not a plain socket name.
# `server' is refused whatever its case, since a case-insensitive file system
# would resolve `Server' to the live socket.
emacs_agent_check_name() {
    local name="$1" lower
    [[ -n "$name" ]] || emacs_agent_usage_error "no target name given"
    lower="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
    case "$lower" in
        server)
            emacs_agent_usage_error "\`$name' is the live session's socket name, not a target; use \`live'" ;;
        start | list | stop)
            emacs_agent_usage_error "\`$name' is not a target name" ;;
    esac
    if [[ ! "$name" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ ]]; then
        emacs_agent_usage_error "\`$name' is not a target name (letters, digits, \`.', \`_' and \`-' only)"
    fi
}

# Say on stderr that the socket NAME (`server' for live) is served by no
# Emacs; WHY ends the message.
emacs_agent_not_running() {
    local name="$1" why="$2"
    if [[ "$name" == server ]]; then
        printf 'emacs-agent: no live session is running (%s)\n' "$why" >&2
    else
        printf 'emacs-agent: target %s is not running (%s)\n' "$name" "$why" >&2
    fi
}

# Say on stderr that the Emacs serving the socket NAME (`server' for live)
# refused a connection though it is still running; WHY ends the message.
emacs_agent_not_accepting() {
    local name="$1" why="$2"
    if [[ "$name" == server ]]; then
        printf 'emacs-agent: the live session is not accepting connections (busy?): %s; try again\n' "$why" >&2
    else
        printf 'emacs-agent: target %s is not accepting connections (busy?): %s; try again\n' "$name" "$why" >&2
    fi
}

# Remove the socket NAME when no process holds it, as `server-start'
# removes a stale socket.  Return 0 when it was removed.
emacs_agent_remove_stale_socket() {
    local socket
    socket="$(emacs_agent_socket "$1")"
    [[ "$1" != server ]] || return 1
    emacs_agent_socket_holders "$socket" >/dev/null
    [[ $? -eq 1 ]] || return 1
    rm -f "$socket"
}

# Exit 2 unless the socket NAME exists.
emacs_agent_require_running() {
    local name="$1" socket
    socket="$(emacs_agent_socket "$name")"
    [[ -S "$socket" ]] && return 0
    emacs_agent_not_running "$name" "no socket at $socket"
    exit 2
}

# Send FORM to the socket NAME and print its string reply decoded.  With
# ENVELOPE set, the exit status follows the envelope's `ok'.
emacs_agent_json_call() {
    local name="$1" form="$2" envelope="${3:-}" reply status
    reply="$(emacs_agent_client "$name" --eval "$form")"
    status=$?
    [[ $status -eq 2 ]] && exit 2
    if [[ $status -ne 0 ]]; then
        [[ -n "$reply" ]] && printf '%s\n' "$reply"
        exit 1
    fi
    if ! emacs_agent_decode_reply "$reply"; then
        printf '%s\n' "$reply"
        emacs_agent_fail "the reply above is not a printed string, so it was not decoded (emacsclient garbles a long reply holding non-ASCII text)"
    fi
    # The envelope's first key is ok; printed, it begins "{\"ok\":true.
    if [[ -n "$envelope" && "$reply" != '"{\"ok\":true'* ]]; then
        exit 1
    fi
    exit 0
}

# Run TIER with its ARGS against NAME (`server' for live).  KIND is `live' or
# `target'.  Every usage check happens before the socket check, and the socket
# check before anything is sent.
emacs_agent_tier() {
    local kind="$1" name="$2"
    shift 2
    [[ $# -gt 0 ]] || emacs_agent_usage_error "no command given for $kind"
    local tier="$1"
    shift
    case "$tier" in
        tools | state)
            [[ "$tier" == state && "$kind" == live ]] &&
                emacs_agent_usage_error "state is a target command; live has none"
            [[ $# -eq 0 ]] || emacs_agent_usage_error "$tier takes no arguments" ;;
        call | call-write)
            [[ $# -eq 2 ]] || emacs_agent_usage_error "$tier takes TOOL and 'JSON'" ;;
        eval)
            [[ $# -eq 1 ]] || emacs_agent_usage_error "eval takes one 'FORM'" ;;
        *)
            emacs_agent_usage_error "unknown command \`$tier' for $kind" ;;
    esac
    emacs_agent_require_running "$name"
    case "$tier" in
        tools)
            emacs_agent_json_call "$name" \
                "(if (fboundp 'jf/agent-api) (jf/agent-api) \"[]\")" ;;
        state)
            emacs_agent_json_call "$name" \
                "(progn (unless (fboundp 'jf/frame-state) (load $(emacs_agent_lisp_string "$EMACS_AGENT_TARGET_SUPPORT") nil t)) (jf/frame-state))" ;;
        call | call-write)
            emacs_agent_json_call "$name" \
                "(jf/agent-call $(emacs_agent_lisp_string "$tier") $(emacs_agent_lisp_string "$1") $(emacs_agent_lisp_string "$2"))" \
                envelope ;;
        eval)
            if [[ "$kind" == live ]]; then
                emacs_agent_json_call "$name" \
                    "(jf/agent-eval $(emacs_agent_lisp_string "$1"))" envelope
            fi
            # The form goes as given; a leading space keeps a form that
            # starts with `-' from being read as an emacsclient option.
            local form="$1"
            [[ "$form" == -* ]] && form=" $form"
            emacs_agent_client "$name" --eval "$form"
            case $? in
                0) exit 0 ;;
                2) exit 2 ;;
                *) exit 1 ;;
            esac ;;
    esac
}

# Seconds `target stop' waits for a target to go: for the kill to be
# delivered, then for the socket to disappear.
EMACS_AGENT_STOP_TIMEOUT=10

# Start the target NAME.  WORKTREE (default: this checkout) runs its
# bin/emacs-isolated.sh --daemon=NAME with EMACS_AGENT_DATA set to DATA
# (default none); BARE set runs EMACS -Q --daemon=NAME instead.  A --daemon
# launch returns once its server is ready, so the target is up when the
# launcher exits 0 and the socket exists; otherwise show the launcher's
# output and exit 2.  The output goes to a file, not a pipe: a process the
# target starts while it initialises may hold a pipe open after the
# launcher exits.  A NAME whose socket a process holds while refusing
# connections (busy) is refused, exit 2, before anything is launched; one
# whose server answers is refused by Emacs and reported already running.
emacs_agent_target_start() {
    local name="$1" worktree="$2" bare="$3" data="$4" launcher out status socket
    local answered="" pids
    local -a cmd
    if [[ -n "$bare" ]]; then
        [[ -z "$worktree" ]] || emacs_agent_usage_error "--worktree does not apply to a --bare target"
        [[ -z "$data" ]] || emacs_agent_usage_error "--data does not apply to a --bare target, which loads no configuration"
        cmd=(env -u EMACS_AGENT_DATA "$(emacs_agent_emacs)" -Q "--daemon=$name")
    else
        launcher="${worktree:-$EMACS_AGENT_ROOT}/bin/emacs-isolated.sh"
        [[ -x "$launcher" ]] ||
            emacs_agent_fail "no executable launcher at $launcher" 2
        cmd=(env "EMACS_AGENT_DATA=${data:-none}" "$launcher" "--daemon=$name")
    fi
    socket="$(emacs_agent_socket "$name")"
    # Emacs replaces a socket whose connection is refused, so a busy
    # target's socket would be taken over and the target orphaned: refuse
    # its name.  A target that answers is left for Emacs to refuse.
    if [[ -S "$socket" ]]; then
        emacs_agent_client "$name" -w 2 --eval t >/dev/null 2>&1
        case $? in
            0) answered=1 ;;
            3)
                pids="$(emacs_agent_socket_holders "$socket")"
                emacs_agent_fail "target $name is already running (busy): process ${pids:-?} holds $socket but refuses connections; stop it or try again" 2 ;;
        esac
    fi
    out="$(mktemp "${TMPDIR:-/tmp}/emacs-agent-start.XXXXXX")" ||
        emacs_agent_fail "cannot create a temporary file" 2
    "${cmd[@]}" </dev/null >"$out" 2>&1
    status=$?
    if [[ $status -eq 0 && -S "$socket" ]]; then
        rm -f "$out"
        exit 0
    fi
    cat "$out" >&2
    rm -f "$out"
    if [[ $status -ne 0 && -n "$answered" ]]; then
        emacs_agent_fail "target $name is already running: its server answers on $socket" 2
    fi
    if [[ $status -ne 0 ]]; then
        emacs_agent_fail "target $name did not start: the launcher exited $status" 2
    fi
    emacs_agent_fail "target $name did not start: the launcher exited 0 but there is no socket at $socket" 2
}

# Print the name of every socket in the socket directory but `server', the
# live session's: the directory is the registry of running targets.  A
# target socket that refuses a connection while no process holds it (its
# Emacs died without removing it) is not listed and is removed; one that
# refuses while a process holds it (a busy Emacs whose accept queue is
# full) is listed as `NAME (busy)' and kept.  A target that accepts the
# connection but does not answer is still running and is listed.
emacs_agent_target_list() {
    local dir entry name
    dir="$(emacs_agent_socket_dir)"
    [[ -d "$dir" ]] || exit 0
    for entry in "$dir"/*; do
        [[ -S "$entry" ]] || continue
        name="${entry##*/}"
        [[ "$name" != server ]] || continue
        emacs_agent_client "$name" -w 2 --eval t >/dev/null 2>&1
        case $? in
            2) emacs_agent_remove_stale_socket "$name"; continue ;;
            3) printf '%s (busy)\n' "$name"; continue ;;
        esac
        printf '%s\n' "$name"
    done
    exit 0
}

# Send (kill-emacs) to the target NAME and return once its socket is gone,
# waiting at most EMACS_AGENT_STOP_TIMEOUT seconds for each step, so a hung
# target fails the stop rather than blocking it.
emacs_agent_target_stop() {
    local name="$1" socket deadline err
    emacs_agent_require_running "$name"
    socket="$(emacs_agent_socket "$name")"
    # The connection closes as the target exits, so the reply and the
    # client's status carry nothing; the socket's removal is the answer.
    # A refused connection is reported as `emacs_agent_client' found it: a
    # target not running has its socket removed when no process holds it
    # (exit 2); a busy one keeps its socket for a later stop (exit 1).
    err="$(emacs_agent_client "$name" -w "$EMACS_AGENT_STOP_TIMEOUT" \
        --eval "(kill-emacs)" 2>&1 >/dev/null)"
    case $? in
        2)
            printf '%s\n' "$err" >&2
            emacs_agent_remove_stale_socket "$name" &&
                printf 'emacs-agent: removed the stale socket %s\n' "$socket" >&2
            exit 2 ;;
        3)
            printf '%s\n' "$err" >&2
            exit 1 ;;
    esac
    deadline=$((SECONDS + EMACS_AGENT_STOP_TIMEOUT))
    while [[ -S "$socket" ]]; do
        if [[ $SECONDS -ge $deadline ]]; then
            emacs_agent_fail "target $name did not stop within ${EMACS_AGENT_STOP_TIMEOUT}s; its socket is still at $socket"
        fi
        sleep 0.1
    done
    exit 0
}

emacs_agent_target() {
    [[ $# -gt 0 ]] || emacs_agent_usage_error "no target named"
    case "$1" in
        start)
            shift
            [[ $# -gt 0 ]] || emacs_agent_usage_error "target start takes NAME"
            local name="$1" worktree="" bare="" data=""
            shift
            emacs_agent_check_name "$name"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --worktree)
                        [[ $# -ge 2 ]] || emacs_agent_usage_error "--worktree takes PATH"
                        worktree="$2"
                        shift 2 ;;
                    --bare)
                        bare=1
                        shift ;;
                    --data)
                        [[ $# -ge 2 ]] || emacs_agent_usage_error "--data takes PROFILE"
                        data="$2"
                        shift 2 ;;
                    *)
                        emacs_agent_usage_error "unknown option \`$1' for target start" ;;
                esac
            done
            emacs_agent_target_start "$name" "$worktree" "$bare" "$data" ;;
        list)
            shift
            [[ $# -eq 0 ]] || emacs_agent_usage_error "target list takes no arguments"
            emacs_agent_target_list ;;
        stop)
            shift
            [[ $# -eq 1 ]] || emacs_agent_usage_error "target stop takes NAME"
            emacs_agent_check_name "$1"
            emacs_agent_target_stop "$1" ;;
        *)
            local name="$1"
            shift
            emacs_agent_check_name "$name"
            emacs_agent_tier target "$name" "$@" ;;
    esac
}

emacs_agent_main() {
    [[ $# -gt 0 ]] || emacs_agent_usage_error "no target named; use \`live' or \`target NAME'"
    case "$1" in
        --help)
            emacs_agent_usage
            exit 0 ;;
        live)
            shift
            emacs_agent_tier live server "$@" ;;
        target)
            shift
            emacs_agent_target "$@" ;;
        *)
            emacs_agent_usage_error "unknown word \`$1'; name a target with \`live' or \`target NAME'" ;;
    esac
}

emacs_agent_main "$@"
