org-roam.db
# Machine-specific
.machine-role

# Runtime - mostly ignored
runtime/custom.el
runtime/data/*
runtime/cache/*
runtime/state/*
runtime/packages/*

# Keep structure
!runtime/data/.gitkeep
!runtime/cache/.gitkeep
!runtime/state/.gitkeep
!runtime/packages/.gitkeep

# State files - machine-specific, ephemeral session data
# Keep directory structure and READMEs only
state/**
!state/**/
!state/**/README.md

# Emacs temp files
*.elc
*.eln
*~
\#*\#
.\#*

# OS
.DS_Store

# worktrees
.worktrees/

# tasks-orchestrator ephemeral state
.orchestrator/
.claude/scheduled_tasks.lock

# orchestrator worktree provisioning logs
.runtime-init.log

# vulpea DB (runtime; should live under runtime/state/ per design D8)
runtime/*.db
runtime/vulpea.db
