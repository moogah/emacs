{
  "permissions": {
    "allow": [
      "Bash(bin/emacs-agent live call:*)",
      "Bash(./bin/emacs-agent live call:*)",
      "Bash(bin/emacs-agent target:*)",
      "Bash(./bin/emacs-agent target:*)"
    ],
    "ask": [
      "Bash(bin/emacs-agent live eval:*)",
      "Bash(./bin/emacs-agent live eval:*)",
      "Bash(bin/emacs-agent live call-write:*)",
      "Bash(./bin/emacs-agent live call-write:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/bin/hooks/validate-task-frontmatter"
          }
        ]
      }
    ]
  }
}
